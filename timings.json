 {
  "poem_id": 21,
  "title": "月下獨酌",
  "read": [
   {
    "text": "月下獨酌，唐，李白",
    "start": 0.0,
    "end": 2.55
   },
   {
    "text": "花間一壺酒，",
    "start": 2.9,
    "end": 4.26
